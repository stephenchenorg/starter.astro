# Astro Adapter 切換
# 使用自訂變數 is_netlify 而非 NETLIFY，因為 Netlify 會自動設定 NETLIFY=true
# 這樣可以在 Netlify 環境中選擇使用 Node adapter 進行測試
# 設為 "true" 使用 @astrojs/netlify，未設定則使用 @astrojs/node
is_netlify=

# 本站對外部署的完整網址（含 protocol，例如 https://www.example.com）
# 用途：astro.config.ts 的 site (sitemap / canonical URL) + security.allowedDomains
# （Astro 5.14+ host header 驗證，未設定會擋同源表單提交）
# 必填：Astro 在 .env 載入前就讀 config，須在部署平台 (Netlify / Vercel / Node host)
# 注入 process.env；本機開發請用 `SITE_URL=http://localhost:4321 yarn dev`
# 或在 shell rc 先 export
SITE_URL=

# API 網域（PUBLIC_ 前綴讓客戶端可存取）
PUBLIC_API_BASE_URL="https://dev-admin.csstudio.tw"

# 內網 API 網域（選填，無 PUBLIC_ 前綴，不會被打包進瀏覽器端）
# 僅供 Astro SSR 伺服器（server-to-server）呼叫後端使用，加速並避開走公開網路
# 只有在 Astro 伺服器與 Laravel 伺服器位於同一內網 (VPC) 時才設定，否則留空即可
# 留空時會自動 fallback 回 PUBLIC_API_BASE_URL，不影響現有行為
# 格式範例（正式環境內網位址，需向管理內網的人確認實際 IP/port）：
# API_BASE_URL=http://10.0.0.2:8002
API_BASE_URL=

# Astro Cookie Session 加密金鑰
SECRET_KEY_BASE=

# GA4 Tracking ID, must be set to enable Google Analytics first and ID is starting with "G-"
# Format: G-XXXXXXXXXX
GA4_TRACKING_ID=

# Google Tag Manager ID, must be set to enable GTM and ID is starting with "GTM-"
# Format: GTM-XXXXXXX
# Recommended: Use GTM to manage all tracking tags in one place
GTM_ID=

# LINE Tag ID for Taiwan market advertising
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LINE_TAG_ID=

# Microsoft Clarity ID for user behavior analytics
# Format: xxxxxxxxxx
CLARITY_ID=

# Facebook Pixel ID for Facebook advertising
# Format: xxxxxxxxxxxxxxx (15-16 digits)
FB_PIXEL_ID=
